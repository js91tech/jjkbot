<%- include('partials/head', { loggedIn: true, title: 'Advanced' }) %>
<% if (flash) { %><div class="flash"><%= flash %></div><% } %>
<h1>Phase 2+ Systems</h1>
<div class="grid">
  <div class="panel">
    <h3>Clans</h3>
    <% clans.forEach(c => { %><p><%= c.name %> (<%= c.id %>)</p><% }) %>
    <form method="post" action="/advanced"><input type="hidden" name="type" value="joinClan" /><input name="clanId" placeholder="tokyo" /><button>Join</button></form>
  </div>
  <div class="panel">
    <h3>Estates</h3>
    <% estates.forEach(e => { %><p>T<%= e.tier %> <%= e.name %> — <%= e.cost %>c</p><% }) %>
    <form method="post" action="/advanced"><input type="hidden" name="type" value="buyEstate" /><input name="tier" type="number" /><button>Buy</button></form>
  </div>
  <div class="panel">
    <h3>Education</h3>
    <% education.forEach(c => { %><p><%= c.id %>: <%= c.name %> (<%= c.cost %>c)</p><% }) %>
    <form method="post" action="/advanced"><input type="hidden" name="type" value="enroll" /><input name="courseId" /><button>Enroll</button></form>
  </div>
  <div class="panel">
    <h3>Company / Drugs</h3>
    <form method="post" action="/advanced"><input type="hidden" name="type" value="joinCompany" /><input name="companyId" placeholder="jujutsu_ops" /><button>Join Company</button></form>
    <form method="post" action="/drug" style="margin-top:6px"><input name="drugId" value="ce_shot" /><button>CE Shot</button></form>
  </div>
  <div class="panel">
    <h3>Forge / Delve / Grab bag</h3>
    <form method="post" action="/advanced"><input type="hidden" name="type" value="forge" /><input name="recipeId" placeholder="cursed_blade" /><button>Forge</button></form>
    <form method="post" action="/advanced"><input type="hidden" name="type" value="delve" /><button>Delve</button></form>
    <form method="post" action="/advanced"><input type="hidden" name="type" value="endDelve" /><button>End Delve</button></form>
    <form method="post" action="/advanced"><input type="hidden" name="type" value="grabbag" /><button>Open Capsule</button></form>
  </div>
  <div class="panel">
    <h3>Commodities</h3>
    <% commodities.forEach(c => { %><p><%= c.name %> @ <%= c.current_price %>c</p><% }) %>
    <form method="post" action="/advanced">
      <input type="hidden" name="type" value="commodity" />
      <input name="commId" placeholder="cursed_rice" />
      <input name="qty" type="number" value="1" />
      <button name="action" value="buy">Buy</button>
      <button name="action" value="sell">Sell</button>
    </form>
  </div>
</div>
<div class="panel">
  <h3>Item Market</h3>
  <ul><% market.forEach(m => { %><li>#<%= m.id %> <%= m.name %> x<%= m.quantity %> — <%= m.price %>c</li><% }) %></ul>
</div>
<div class="panel">
  <h3>Gold Market</h3>
  <ul><% gold.forEach(g => { %><li>#<%= g.id %> <%= g.gold_amount %> objects — <%= g.price %>c</li><% }) %></ul>
</div>
<%- include('partials/foot') %>
