DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_application_id
DISCORD_CLIENT_SECRET=your_oauth_secret
# Server ID for instant slash commands (recommended). Leave empty for global (slow).
DISCORD_GUILD_ID=
# Bot auto-registers slash commands on start (set false to disable)
REGISTER_COMMANDS_ON_START=true

DATABASE_PATH=./data/jjk.db
WEB_PORT=3847
# Must match Discord OAuth2 redirect exactly (https, no trailing slash)
WEB_BASE_URL=http://localhost:3847
# On Railway you can omit WEB_BASE_URL if RAILWAY_PUBLIC_DOMAIN is set; otherwise set:
# WEB_BASE_URL=https://your-service.up.railway.app
SESSION_SECRET=change_me_to_random_string

# Optional: comma-separated Discord user IDs with admin powers
ADMIN_DISCORD_IDS=
